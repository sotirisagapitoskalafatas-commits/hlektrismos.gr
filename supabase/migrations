/*
# Create leads, providers, and scrape_jobs tables

1. New Tables
- `leads`: Public lead-capture submissions from the landing page.
- `providers`: Greek energy providers scraped/managed by the CRM.
- `scrape_jobs`: AI scraper job tracking for the dashboard agent.

2. Security
- `leads`: public (anon) can INSERT new leads via column-restricted grant;
  only authenticated can SELECT/UPDATE/DELETE.
- `providers` / `scrape_jobs`: authenticated-only CRUD.
*/

CREATE TABLE IF NOT EXISTS leads (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  full_name text NOT NULL,
  phone text NOT NULL,
  email text,
  service_type text NOT NULL DEFAULT 'electricity',
  property_type text NOT NULL DEFAULT 'home',
  monthly_bill numeric,
  postal_code text,
  notes text,
  status text NOT NULL DEFAULT 'new',
  assigned_to uuid,
  created_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE leads ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "anon_insert_leads" ON leads;
CREATE POLICY "anon_insert_leads" ON leads FOR INSERT
  TO anon, authenticated WITH CHECK (true);

DROP POLICY IF EXISTS "auth_select_leads" ON leads;
CREATE POLICY "auth_select_leads" ON leads FOR SELECT
  TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_update_leads" ON leads;
CREATE POLICY "auth_update_leads" ON leads FOR UPDATE
  TO authenticated USING (true) WITH CHECK (true);

DROP POLICY IF EXISTS "auth_delete_leads" ON leads;
CREATE POLICY "auth_delete_leads" ON leads FOR DELETE
  TO authenticated USING (true);

REVOKE INSERT ON leads FROM anon;
GRANT INSERT (full_name, phone, email, service_type, property_type, monthly_bill, postal_code, notes) ON leads TO anon;

REVOKE SELECT ON leads FROM anon;

CREATE TABLE IF NOT EXISTS providers (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  name text NOT NULL,
  type text NOT NULL DEFAULT 'electricity',
  logo_url text,
  website_url text,
  phone text,
  coverage_area text,
  base_tariff numeric,
  discount_pct numeric,
  rating numeric,
  active boolean NOT NULL DEFAULT true,
  last_updated timestamptz DEFAULT now(),
  created_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE providers ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "auth_select_providers" ON providers;
CREATE POLICY "auth_select_providers" ON providers FOR SELECT
  TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_insert_providers" ON providers;
CREATE POLICY "auth_insert_providers" ON providers FOR INSERT
  TO authenticated WITH CHECK (true);

DROP POLICY IF EXISTS "auth_update_providers" ON providers;
CREATE POLICY "auth_update_providers" ON providers FOR UPDATE
  TO authenticated USING (true) WITH CHECK (true);

DROP POLICY IF EXISTS "auth_delete_providers" ON providers;
CREATE POLICY "auth_delete_providers" ON providers FOR DELETE
  TO authenticated USING (true);

CREATE TABLE IF NOT EXISTS scrape_jobs (
  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
  target text NOT NULL,
  status text NOT NULL DEFAULT 'pending',
  records_found int NOT NULL DEFAULT 0,
  result_summary text,
  started_by uuid,
  started_at timestamptz,
  completed_at timestamptz,
  created_at timestamptz NOT NULL DEFAULT now()
);

ALTER TABLE scrape_jobs ENABLE ROW LEVEL SECURITY;

DROP POLICY IF EXISTS "auth_select_scrape_jobs" ON scrape_jobs;
CREATE POLICY "auth_select_scrape_jobs" ON scrape_jobs FOR SELECT
  TO authenticated USING (true);

DROP POLICY IF EXISTS "auth_insert_scrape_jobs" ON scrape_jobs;
CREATE POLICY "auth_insert_scrape_jobs" ON scrape_jobs FOR INSERT
  TO authenticated WITH CHECK (true);

DROP POLICY IF EXISTS "auth_update_scrape_jobs" ON scrape_jobs;
CREATE POLICY "auth_update_scrape_jobs" ON scrape_jobs FOR UPDATE
  TO authenticated USING (true) WITH CHECK (true);

DROP POLICY IF EXISTS "auth_delete_scrape_jobs" ON scrape_jobs;
CREATE POLICY "auth_delete_scrape_jobs" ON scrape_jobs FOR DELETE
  TO authenticated USING (true);

CREATE INDEX IF NOT EXISTS idx_leads_status ON leads (status);
CREATE INDEX IF NOT EXISTS idx_leads_created_at ON leads (created_at DESC);
CREATE INDEX IF NOT EXISTS idx_providers_type ON providers (type);
CREATE INDEX IF NOT EXISTS idx_scrape_jobs_status ON scrape_jobs (status);
